HTTP_ADDR=:18080
DATABASE_URL=postgres://railhead:railhead@127.0.0.1:5432/railhead?sslmode=disable
DATABASE_MAX_CONNS=32
REDIS_URL=redis://127.0.0.1:6379/0
ADMIN_TOKEN=dev-admin-token
SEED_API_KEY=sk-railhead-demo
SEED_KEY_NAME=demo
SEED_QUOTA=10000000
# 0 表示这一项不限制。压测网关吞吐时用 0，避免把限流器本身测成瓶颈。
SEED_RPM=0
SEED_TPM=0
SEED_CONCURRENCY=0
CACHE_ENABLED=true
CACHE_TTL=60s
KEY_CACHE_TTL=5s
CHANNELS_FILE=configs/channels.docker.json
MAX_ATTEMPTS=3
RETRY_BASE=20ms
REQUEST_TIMEOUT=120s
BREAKER_THRESHOLD=5
BREAKER_COOLDOWN=15s
BREAKER_PROBE_TIMEOUT=30s
DEFAULT_MAX_TOKENS=32
MAX_TOKENS_CAP=4096
RESERVE_MARGIN=0
CHANNEL_RELOAD=5s
STALE_RESERVATION_AGE=3m
STALE_SWEEP_INTERVAL=30s
LOG_LEVEL=info
ENABLE_PPROF=false
PPROF_ADDR=127.0.0.1:16060
